Grammar

    0 $accept: program $end

    1 program: TOK_MAIN TOK_LLAVEIZQUIERDA declarations er1 functions er2 statements TOK_LLAVEDERECHA

    2 er1: %empty

    3 er2: %empty

    4 declarations: declaration
    5             | declaration declarations

    6 declaration: class identifiers TOK_PUNTOYCOMA

    7 class: class_scalar
    8      | class_vector

    9 class_scalar: type

   10 type: TOK_INT
   11     | TOK_BOOLEAN

   12 class_vector: TOK_ARRAY type TOK_CORCHETEIZQUIERDO constant_int TOK_CORCHETEDERECHO

   13 identifiers: identifier
   14            | identifier TOK_COMA identifiers

   15 functions: function functions
   16          | %empty

   17 function: fn_declarations statements TOK_LLAVEDERECHA

   18 fn_name: TOK_FUNCTION type TOK_IDENTIFICADOR

   19 fn_declarations: fn_name TOK_PARENTESISIZQUIERDO function_params TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA function_declarations

   20 function_params: function_param remaining_function_params
   21                | %empty

   22 remaining_function_params: TOK_PUNTOYCOMA function_param remaining_function_params
   23                          | %empty

   24 function_param: type TOK_IDENTIFICADOR

   25 function_declarations: declarations
   26                      | %empty

   27 statements: statement
   28           | statement statements

   29 statement: simple_statement TOK_PUNTOYCOMA
   30          | block

   31 simple_statement: assignment
   32                 | reading
   33                 | writing
   34                 | function_return

   35 block: conditional
   36      | loop

   37 assignment: TOK_IDENTIFICADOR TOK_ASIGNACION exp
   38           | vector_element TOK_ASIGNACION exp

   39 vector_element: TOK_IDENTIFICADOR TOK_CORCHETEIZQUIERDO exp TOK_CORCHETEDERECHO

   40 conditional: if_exp_stm
   41            | if_exp_stm TOK_ELSE TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   42 if_exp_stm: if_exp statements TOK_LLAVEDERECHA

   43 if_exp: TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA

   44 loop: TOK_WHILE TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   45 reading: TOK_SCANF TOK_IDENTIFICADOR

   46 writing: TOK_PRINTF exp

   47 function_return: TOK_RETURN exp

   48 exp: exp TOK_MAS exp
   49    | exp TOK_MENOS exp
   50    | exp TOK_DIVISION exp
   51    | exp TOK_ASTERISCO exp
   52    | TOK_MENOS exp
   53    | exp TOK_AND exp
   54    | exp TOK_OR exp
   55    | TOK_NOT exp
   56    | TOK_IDENTIFICADOR
   57    | constant
   58    | TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO
   59    | TOK_PARENTESISIZQUIERDO comparison TOK_PARENTESISDERECHO
   60    | vector_element
   61    | TOK_IDENTIFICADOR TOK_PARENTESISIZQUIERDO exp_list TOK_PARENTESISDERECHO

   62 exp_list: exp exp_remaining_list
   63         | %empty

   64 exp_remaining_list: TOK_COMA exp exp_remaining_list
   65                   | %empty

   66 comparison: exp TOK_IGUAL exp
   67           | exp TOK_DISTINTO exp
   68           | exp TOK_MENORIGUAL exp
   69           | exp TOK_MAYORIGUAL exp
   70           | exp TOK_MENOR exp
   71           | exp TOK_MAYOR exp

   72 constant: constant_logic
   73         | constant_int

   74 constant_logic: TOK_TRUE
   75               | TOK_FALSE

   76 constant_int: TOK_CONSTANTE_ENTERA

   77 identifier: TOK_IDENTIFICADOR


