Grammar

    0 $accept: program $end

    1 program: TOK_MAIN TOK_LLAVEIZQUIERDA declarations er1 functions er2 statements TOK_LLAVEDERECHA

    2 er1: %empty

    3 er2: %empty

    4 declarations: declaration
    5             | declaration declarations

    6 declaration: class identifiers TOK_PUNTOYCOMA

    7 class: class_scalar
    8      | class_vector

    9 class_scalar: type

   10 type: TOK_INT
   11     | TOK_BOOLEAN

   12 class_vector: TOK_ARRAY type TOK_CORCHETEIZQUIERDO constant_int TOK_CORCHETEDERECHO

   13 identifiers: identifier
   14            | identifier TOK_COMA identifiers

   15 functions: function functions
   16          | %empty

   17 function: TOK_FUNCTION type identifier TOK_PARENTESISIZQUIERDO function_params TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA function_declarations statements TOK_LLAVEDERECHA

   18 function_params: function_param remaining_function_params
   19                | %empty

   20 remaining_function_params: TOK_PUNTOYCOMA function_param remaining_function_params
   21                          | %empty

   22 function_param: type identifier

   23 function_declarations: declarations
   24                      | %empty

   25 statements: statement
   26           | statement statements

   27 statement: simple_statement TOK_PUNTOYCOMA
   28          | block

   29 simple_statement: assignment
   30                 | reading
   31                 | writing
   32                 | function_return

   33 block: conditional
   34      | loop

   35 assignment: TOK_IDENTIFICADOR TOK_ASIGNACION exp
   36           | vector_element TOK_ASIGNACION exp

   37 vector_element: identifier TOK_CORCHETEIZQUIERDO exp TOK_CORCHETEDERECHO

   38 conditional: TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA
   39            | TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA TOK_ELSE TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   40 loop: TOK_WHILE TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   41 reading: TOK_SCANF identifier

   42 writing: TOK_PRINTF exp

   43 function_return: TOK_RETURN exp

   44 exp: exp TOK_MAS exp
   45    | exp TOK_MENOS exp
   46    | exp TOK_DIVISION exp
   47    | exp TOK_ASTERISCO exp
   48    | TOK_MENOS exp
   49    | exp TOK_AND exp
   50    | exp TOK_OR exp
   51    | TOK_NOT exp
   52    | TOK_IDENTIFICADOR
   53    | constant
   54    | TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO
   55    | TOK_PARENTESISIZQUIERDO comparison TOK_PARENTESISDERECHO
   56    | vector_element
   57    | identifier TOK_PARENTESISIZQUIERDO exp_list TOK_PARENTESISDERECHO

   58 exp_list: exp exp_remaining_list
   59         | %empty

   60 exp_remaining_list: TOK_COMA exp exp_remaining_list
   61                   | %empty

   62 comparison: exp TOK_IGUAL exp
   63           | exp TOK_DISTINTO exp
   64           | exp TOK_MENORIGUAL exp
   65           | exp TOK_MAYORIGUAL exp
   66           | exp TOK_MENOR exp
   67           | exp TOK_MAYOR exp

   68 constant: constant_logic
   69         | constant_int

   70 constant_logic: TOK_TRUE
   71               | TOK_FALSE

   72 constant_int: TOK_CONSTANTE_ENTERA

   73 identifier: TOK_IDENTIFICADOR


