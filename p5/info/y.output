Terminals unused in grammar

    TOK_ERROR


Grammar

    0 $accept: program $end

    1 program: TOK_MAIN TOK_LLAVEIZQUIERDA declarations er1 functions er2 statements TOK_LLAVEDERECHA

    2 er1: %empty

    3 er2: %empty

    4 declarations: declaration
    5             | declaration declarations

    6 declaration: class identifiers TOK_PUNTOYCOMA

    7 class: class_scalar
    8      | class_vector

    9 class_scalar: type

   10 type: TOK_INT
   11     | TOK_BOOLEAN

   12 class_vector: TOK_ARRAY type TOK_CORCHETEIZQUIERDO constant_int TOK_CORCHETEDERECHO

   13 identifiers: identifier
   14            | identifier TOK_COMA identifiers

   15 functions: function functions
   16          | %empty

   17 function: fn_declarations statements TOK_LLAVEDERECHA

   18 fn_name: TOK_FUNCTION type TOK_IDENTIFICADOR

   19 fn_declarations: fn_name TOK_PARENTESISIZQUIERDO function_params TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA function_declarations

   20 function_params: function_param remaining_function_params
   21                | %empty

   22 remaining_function_params: TOK_PUNTOYCOMA function_param remaining_function_params
   23                          | %empty

   24 function_param: type function_param_identifier

   25 function_param_identifier: TOK_IDENTIFICADOR

   26 function_declarations: declarations
   27                      | %empty

   28 statements: statement
   29           | statement statements

   30 statement: simple_statement TOK_PUNTOYCOMA
   31          | block

   32 simple_statement: assignment
   33                 | reading
   34                 | writing
   35                 | function_return

   36 block: conditional
   37      | loop

   38 assignment: TOK_IDENTIFICADOR TOK_ASIGNACION exp
   39           | vector_element TOK_ASIGNACION exp

   40 vector_element: TOK_IDENTIFICADOR TOK_CORCHETEIZQUIERDO exp TOK_CORCHETEDERECHO

   41 conditional: if_exp_stm
   42            | if_exp_stm TOK_ELSE TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   43 if_exp_stm: if_exp statements TOK_LLAVEDERECHA

   44 if_exp: TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA

   45 loop: TOK_WHILE TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   46 reading: TOK_SCANF TOK_IDENTIFICADOR

   47 writing: TOK_PRINTF exp

   48 function_return: TOK_RETURN exp

   49 exp: exp TOK_MAS exp
   50    | exp TOK_MENOS exp
   51    | exp TOK_DIVISION exp
   52    | exp TOK_ASTERISCO exp
   53    | TOK_MENOS exp
   54    | exp TOK_AND exp
   55    | exp TOK_OR exp
   56    | TOK_NOT exp
   57    | TOK_IDENTIFICADOR
   58    | constant
   59    | TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO
   60    | TOK_PARENTESISIZQUIERDO comparison TOK_PARENTESISDERECHO
   61    | vector_element
   62    | TOK_IDENTIFICADOR TOK_PARENTESISIZQUIERDO exp_list TOK_PARENTESISDERECHO

   63 exp_list: exp exp_remaining_list
   64         | %empty

   65 exp_remaining_list: TOK_COMA exp exp_remaining_list
   66                   | %empty

   67 comparison: exp TOK_IGUAL exp
   68           | exp TOK_DISTINTO exp
   69           | exp TOK_MENORIGUAL exp
   70           | exp TOK_MAYORIGUAL exp
   71           | exp TOK_MENOR exp
   72           | exp TOK_MAYOR exp

   73 constant: constant_logic
   74         | constant_int

   75 constant_logic: TOK_TRUE
   76               | TOK_FALSE

   77 constant_int: TOK_CONSTANTE_ENTERA

   78 identifier: TOK_IDENTIFICADOR


