Terminals unused in grammar

    TOK_ERROR


Grammar

    0 $accept: program $end

    1 program: TOK_MAIN TOK_LLAVEIZQUIERDA declarations er1 functions er2 statements TOK_LLAVEDERECHA

    2 er1: %empty

    3 er2: %empty

    4 declarations: declaration
    5             | declaration declarations

    6 declaration: class identifiers TOK_PUNTOYCOMA

    7 class: class_scalar
    8      | class_vector

    9 class_scalar: type

   10 type: TOK_INT
   11     | TOK_BOOLEAN

   12 class_vector: TOK_ARRAY type TOK_CORCHETEIZQUIERDO constant_int TOK_CORCHETEDERECHO

   13 identifiers: identifier
   14            | identifier TOK_COMA identifiers

   15 functions: function functions
   16          | %empty

   17 function: fer2 fer1 statements TOK_LLAVEDERECHA

   18 fer1: %empty

   19 fn_name: TOK_FUNCTION type TOK_IDENTIFICADOR

   20 fn_declarations: fn_name TOK_PARENTESISIZQUIERDO function_params TOK_PARENTESISDERECHO

   21 fer2: fn_declarations TOK_LLAVEIZQUIERDA function_declarations

   22 function_params: function_param remaining_function_params
   23                | %empty

   24 remaining_function_params: TOK_PUNTOYCOMA function_param remaining_function_params
   25                          | %empty

   26 function_param: type function_param_identifier

   27 function_param_identifier: TOK_IDENTIFICADOR

   28 function_declarations: declarations
   29                      | %empty

   30 statements: statement
   31           | statement statements

   32 statement: simple_statement TOK_PUNTOYCOMA
   33          | block

   34 simple_statement: assignment
   35                 | reading
   36                 | writing
   37                 | function_return

   38 block: conditional
   39      | loop

   40 assignment: TOK_IDENTIFICADOR TOK_ASIGNACION exp
   41           | vector_element TOK_ASIGNACION exp

   42 vector_element: TOK_IDENTIFICADOR TOK_CORCHETEIZQUIERDO exp TOK_CORCHETEDERECHO

   43 conditional: if_exp_stm
   44            | if_exp_stm TOK_ELSE TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   45 if_exp_stm: if_exp statements TOK_LLAVEDERECHA

   46 if_exp: TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA

   47 loop: while_exp TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   48 while_exp: while TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO

   49 while: TOK_WHILE

   50 reading: TOK_SCANF TOK_IDENTIFICADOR

   51 writing: TOK_PRINTF exp

   52 function_return: TOK_RETURN exp

   53 exp: exp TOK_MAS exp
   54    | exp TOK_MENOS exp
   55    | exp TOK_DIVISION exp
   56    | exp TOK_ASTERISCO exp
   57    | TOK_MENOS exp
   58    | exp TOK_AND exp
   59    | exp TOK_OR exp
   60    | TOK_NOT exp
   61    | TOK_IDENTIFICADOR
   62    | constant
   63    | TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO
   64    | TOK_PARENTESISIZQUIERDO comparison TOK_PARENTESISDERECHO
   65    | vector_element
   66    | fidf_funct_call TOK_PARENTESISIZQUIERDO exp_list TOK_PARENTESISDERECHO

   67 fidf_funct_call: TOK_IDENTIFICADOR

   68 exp_list: exp exp_remaining_list
   69         | %empty

   70 exp_remaining_list: TOK_COMA exp exp_remaining_list
   71                   | %empty

   72 comparison: exp TOK_IGUAL exp
   73           | exp TOK_DISTINTO exp
   74           | exp TOK_MENORIGUAL exp
   75           | exp TOK_MAYORIGUAL exp
   76           | exp TOK_MENOR exp
   77           | exp TOK_MAYOR exp

   78 constant: constant_logic
   79         | constant_int

   80 constant_logic: TOK_TRUE
   81               | TOK_FALSE

   82 constant_int: TOK_CONSTANTE_ENTERA

   83 identifier: TOK_IDENTIFICADOR


