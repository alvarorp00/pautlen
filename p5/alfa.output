Grammar

    0 $accept: program $end

    1 program: TOK_MAIN TOK_LLAVEIZQUIERDA declarations functions statements TOK_LLAVEDERECHA

    2 declarations: declaration
    3             | declaration declarations

    4 declaration: class identifiers TOK_PUNTOYCOMA

    5 class: class_scalar
    6      | class_vector

    7 class_scalar: type

    8 type: TOK_INT
    9     | TOK_BOOLEAN

   10 class_vector: TOK_ARRAY type TOK_CORCHETEIZQUIERDO constant_int TOK_CORCHETEDERECHO

   11 identifiers: identifier
   12            | identifier TOK_COMA identifiers

   13 functions: function functions
   14          | %empty

   15 function: TOK_FUNCTION type identifier TOK_PARENTESISIZQUIERDO function_params TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA function_declarations statements TOK_LLAVEDERECHA

   16 function_params: function_param remaining_function_params
   17                | %empty

   18 remaining_function_params: TOK_PUNTOYCOMA function_param remaining_function_params
   19                          | %empty

   20 function_param: type identifier

   21 function_declarations: declarations
   22                      | %empty

   23 statements: statement
   24           | statement statements

   25 statement: simple_statement TOK_PUNTOYCOMA
   26          | block

   27 simple_statement: assignment
   28                 | reading
   29                 | writing
   30                 | function_return

   31 block: conditional
   32      | loop

   33 assignment: identifier TOK_ASIGNACION exp
   34           | vector_element TOK_ASIGNACION exp

   35 vector_element: identifier TOK_CORCHETEIZQUIERDO exp TOK_CORCHETEDERECHO

   36 conditional: TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA
   37            | TOK_IF TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA TOK_ELSE TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   38 loop: TOK_WHILE TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO TOK_LLAVEIZQUIERDA statements TOK_LLAVEDERECHA

   39 reading: TOK_SCANF identifier

   40 writing: TOK_PRINTF exp

   41 function_return: TOK_RETURN exp

   42 exp: exp TOK_MAS exp
   43    | exp TOK_MENOS exp
   44    | exp TOK_DIVISION exp
   45    | exp TOK_ASTERISCO exp
   46    | TOK_MENOS exp
   47    | exp TOK_AND exp
   48    | exp TOK_OR exp
   49    | TOK_NOT exp
   50    | identifier
   51    | constant
   52    | TOK_PARENTESISIZQUIERDO exp TOK_PARENTESISDERECHO
   53    | TOK_PARENTESISIZQUIERDO comparison TOK_PARENTESISDERECHO
   54    | vector_element
   55    | identifier TOK_PARENTESISIZQUIERDO exp_list TOK_PARENTESISDERECHO

   56 exp_list: exp exp_remaining_list
   57         | %empty

   58 exp_remaining_list: TOK_COMA exp exp_remaining_list
   59                   | %empty

   60 comparison: exp TOK_IGUAL exp
   61           | exp TOK_DISTINTO exp
   62           | exp TOK_MENORIGUAL exp
   63           | exp TOK_MAYORIGUAL exp
   64           | exp TOK_MENOR exp
   65           | exp TOK_MAYOR exp

   66 constant: constant_logic
   67         | constant_int

   68 constant_logic: TOK_TRUE
   69               | TOK_FALSE

   70 constant_int: TOK_CONSTANTE_ENTERA

   71 identifier: TOK_IDENTIFICADOR


